{
    "name": "nikita/php-smarty-blog",
    "description": "A small blog built with plain PHP, MySQL and Smarty",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "smarty/smarty": "^5.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\Database\\Seeders\\": "database/seeders/",
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
